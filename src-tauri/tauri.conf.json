{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUS Monitor",
  "version": "0.1.24",
  "identifier": "com.cusmonitor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CUS Monitor",
        "width": 600,
        "height": 400,
        "resizable": false,
        "focus": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/vanshaj-carrerus/cus-spy-monitor/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RDA4MjU0M0FFRTE0NUYKUldSZkZPNDZWSUxRaDJWdG9MdWVZck5oR0M4aCtTenVLTzc2a3BrUi9rTzJibkloMzMvNzZXdmUK"
    },
    "shell": {}
  }
}