{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "autostart:default",
    "shell:default",
    "http:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/monitor-worker",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "https://cus-spy-admin-dashboard.vercel.app/*"
        }
      ]
    }
  ]
}